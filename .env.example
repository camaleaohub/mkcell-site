# Opcional. Copie para .env.local só se precisar mudar algum valor.
# As variáveis são lidas no build: mudou, rode `npm run build` de novo.

# Endereço público do site, sem barra no final. Vai no canonical, no Open Graph,
# no JSON-LD e no sitemap. Padrão: https://mkcellstore.com.br
NEXT_PUBLIC_SITE_URL=https://mkcellstore.com.br

# Link "Área da equipe" no rodapé, que leva ao sistema interno da loja (não faz
# parte deste site). Deixe vazio para esconder o link.
# Padrão: https://mkcellstore.com.br/login
NEXT_PUBLIC_TEAM_LOGIN_URL=https://mkcellstore.com.br/login
